# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Local environment variables
.env
.env.*
!env.example.sh

# Logs and temporary files
logs/
tmp/
temp/

# Raw files that should remain local if redistribution is restricted
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

# Large local archives
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Local binary outputs
*.pkl
*.pickle
*.npy
*.npz

# Keep reproducibility CSV, notebooks, figures, PDFs, and documentation trackable
!*.csv
!*.ipynb
!*.eps
!*.png
!*.pdf
!*.md

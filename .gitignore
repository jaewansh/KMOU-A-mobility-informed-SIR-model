# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Local environment files
.env
.env.*
!env.example.sh

# Logs and temporary files
logs/
tmp/
temp/

# Raw data files
# Raw data may have redistribution restrictions and should not be committed by default.
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

# Large local archives
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Local spreadsheet inputs
# Processed CSV outputs may be committed separately for reproducibility.
*.xls
*.xlsx

# Local binary outputs
*.pkl
*.pickle
*.npy
*.npz

# Keep processed reproducibility outputs trackable
!data/processed/
!data/processed/**
!results/
!results/**
